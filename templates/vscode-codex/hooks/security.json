{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/pretooluse.js",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .agent-security/final_check.js --post-tool-use",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .agent-security/final_check.js",
        "timeout": 60
      }
    ]
  }
}
