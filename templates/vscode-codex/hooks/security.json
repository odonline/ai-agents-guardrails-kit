{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 .github/hooks/pretooluse.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 .agent-security/final_check.py --post-tool-use",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agent-security/final_check.py",
        "timeout": 60
      }
    ]
  }
}
